# Copy this file to ".env" and fill in your own values. NEVER commit .env.
# Get a FREE Gemini key (no card) at: https://aistudio.google.com/apikey
# You may add several keys separated by commas — the app switches automatically
# if one key hits its daily quota (Key Pool, see src/config.py).
GOOGLE_API_KEYS=your-key-1,your-key-2

# Optional LangSmith tracing (free tier). Leave blank to disable tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=CreatorCrew-RAG
